import java.io.*;
import java.util.*;

public class Solution {
	static final int[] dr = { 0, 1, 0, -1 };
	static final int[] dc = { 1, 0, -1, 0 };

	static int n, result;
	static int[][] map = new int[100][100];
	static int[][] distance = new int[100][100];
	static boolean[][] visited = new boolean[100][100];

	static class Point implements Comparable<Point> {
		int r, c;

		public Point(int r, int c) {
			this.r = r;
			this.c = c;
		}

		@Override
		public int compareTo(Point o) {
			return Integer.compare(distance[this.r][this.c], distance[o.r][o.c]);
		}
		
	}

	public static void main(String[] args) throws Exception {
		//System.setIn(new FileInputStream("input.txt"));

		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringBuilder sb = new StringBuilder();
		StringTokenizer st;

		int T = Integer.parseInt(br.readLine());

		for (int tc = 1; tc <= T; tc++) {
			sb.append("#").append(tc).append(" ");

			result = Integer.MAX_VALUE;
			n = Integer.parseInt(br.readLine());

			map = new int[n][n];
			visited = new boolean[n][n];
			distance = new int[n][n];
			

			String s;
			for (int i = 0; i < n; i++) {
				Arrays.fill(visited[i], false);
				Arrays.fill(distance[i], Integer.MAX_VALUE);
				s = br.readLine();
				for (int j = 0; j < n; j++) {
					map[i][j] = s.charAt(j) - '0';
				}
			}

			// dijkstra
			dijkstra(0, 0);

			sb.append(distance[n - 1][n - 1]);
//			System.out.println(sb);
//			sb.setLength(0);
			sb.append("\n");
		}
		System.out.println(sb);
	}

	static void dijkstra(int r, int c) {
		PriorityQueue<Point> pq = new PriorityQueue<>();
		
		pq.add(new Point(r, c));
		distance[r][c] = 0;
		
		while (!pq.isEmpty()) {
			Point shortest = pq.poll();
			int sR = shortest.r;
			int sC = shortest.c;
			// skip if visited
			if (visited[sR][sC])
				continue;
			visited[sR][sC] = true;

			// search 4 directions from shortest
			for (int d = 0; d < 4; d++) {
				int nr = sR + dr[d];
				int nc = sC + dc[d];
				
				if (nr >= 0 && nr < n && nc >= 0 && nc < n && !visited[nr][nc]) {
					distance[nr][nc] = Math.min(distance[nr][nc], distance[sR][sC] + map[nr][nc]);
					// add point to q
					pq.add(new Point(nr ,nc));
				}
			}
		}
	}
}