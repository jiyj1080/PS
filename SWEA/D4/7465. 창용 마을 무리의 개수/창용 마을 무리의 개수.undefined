import java.util.*;
import java.io.*;

class Solution {
	static int N, M, parent[] = new int[101], rank[], unionCnt;

	public static void main(String[] args) throws Exception {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringBuilder sb = new StringBuilder();
		StringTokenizer st;

		int T = Integer.parseInt(br.readLine());
		for (int tc = 1; tc <= T; tc++) {
			st = new StringTokenizer(br.readLine());
			N = Integer.parseInt(st.nextToken()); // 1 <= N <= 100
			M = Integer.parseInt(st.nextToken()); // 1 <= M <= N(N-1)/2 ~ 5000
//			parent = new int[N + 1];
			rank = new int[N + 1];
			unionCnt = N;
			for (int i = 1; i <= N; i++) {
				parent[i] = i;
			}
			for (int i = 0; i < M; i++) {
				st = new StringTokenizer(br.readLine());
				int a = Integer.parseInt(st.nextToken());
				int b = Integer.parseInt(st.nextToken());
				if (union(a, b)) unionCnt--;
			}

			sb.append("#").append(tc).append(" ").append(unionCnt);// .append("\n")
			System.out.println(sb);
			sb.setLength(0);
		}
//		System.out.println(sb);
	}

	static boolean union(int a, int b) {
		int parentA = findSet(a);
		int parentB = findSet(b);
		// skip if same parent
		if (parentA == parentB)
			return false;

		if (rank[parentA] == rank[parentB]) {
			rank[parentA]++;
			parent[parentB] = parentA;
		} else if (rank[parentA] > rank[parentB]) {
			parent[parentB] = parentA;
		} else {
			parent[parentA] = parentB;
		}
		return true;
	}

	static int findSet(int a) {
		if (parent[a] == a)
			return a;
		return parent[a] = findSet(parent[a]);
	}
}